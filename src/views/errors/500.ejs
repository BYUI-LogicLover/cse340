<%- include('../partials/header') %>
<div class="flex flex-col items-center justify-center py-20 text-center space-y-6 max-w-3xl mx-auto">
  <div class="text-red-500">
    <svg class="w-24 h-24 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
  </div>
  <h1 class="text-5xl font-extrabold text-gray-900">Something Went Wrong</h1>
  <p class="text-xl text-gray-500">We are experiencing technical difficulties. Our team has been notified and is working to fix the issue.</p>
  <a href="/" class="btn-primary mt-4 bg-red-600 hover:bg-red-700">Return to Homepage</a>

  <% if (NODE_ENV === 'development') { %>
    <details class="w-full mt-8 text-left bg-gray-50 p-6 rounded-xl border border-gray-200">
      <summary class="font-bold text-gray-700 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary-500 rounded px-2 py-1 -ml-2 mb-4">Error Details (Development Only)</summary>
      <pre class="bg-gray-800 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm mb-4"><%= error %></pre>
      <pre class="bg-gray-800 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm"><%= stack %></pre>
    </details>
  <% } %>
</div>
<%- include('../partials/footer') %>
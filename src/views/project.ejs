<%- include('partials/header') %>
<div class="max-w-4xl mx-auto space-y-8">
  <div class="card p-8">
    <div class="flex justify-between items-start mb-6">
      <h1 class="text-3xl font-extrabold text-gray-900"><%= project.title %></h1>
      <% if (isAdmin) { %>
        <div class="flex gap-2">
          <a href="/edit-project/<%= project.project_id %>" class="inline-block px-4 py-2 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition text-sm">Edit Project</a>
          <a href="/project/<%= project.project_id %>/assign-categories" class="inline-block px-4 py-2 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition text-sm">Edit Categories</a>
        </div>
      <% } %>
    </div>

    <p class="text-lg text-gray-700 mb-8"><%= project.description %></p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 bg-gray-50 p-6 rounded-xl border border-gray-100">
      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">Date</p>
        <p class="text-gray-900 font-medium"><%= project.start_date.toLocaleDateString() %></p>
      </div>
      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">Location</p>
        <p class="text-gray-900 font-medium"><%= project.location %></p>
      </div>
      <div class="md:col-span-2">
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">Organization</p>
        <p class="text-gray-900 font-medium"><a href="/organization/<%= project.organization_id %>" class="text-primary-600 hover:underline"><%= project.organization_name %></a></p>
      </div>
    </div>

    <% if (categories.length > 0) { %>
      <div class="border-t border-gray-100 pt-6">
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Categories</h3>
        <div class="flex flex-wrap gap-2">
          <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>" class="inline-flex items-center rounded-full bg-primary-50 px-3 py-1 text-sm font-medium text-primary-700 ring-1 ring-inset ring-primary-700/10 hover:bg-primary-100 transition-colors"><%= category.name %></a>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>

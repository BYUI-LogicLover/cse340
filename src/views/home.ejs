<%- include('partials/header') %>

<div class="flex flex-col items-center justify-center text-center py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl space-y-8">
    <img class="mx-auto h-40 w-auto object-contain drop-shadow-md" src="images/cse340-service-network.png" alt="CSE 340 Service Network Logo">
    
    <div class="space-y-4">
      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        Welcome to the <span class="text-primary-600">CSE 340 Service Network!</span>
      </h1>
      <p class="text-xl text-gray-500 max-w-2xl mx-auto">
        Our mission is to promote service across the world by connecting volunteers with service opportunities in their community.
      </p>
    </div>

    <div class="pt-6 flex justify-center gap-4">
      <% if (locals.isLoggedIn) { %>
        <a href="/dashboard" class="btn-primary px-8 py-4 text-lg">Go to My Dashboard</a>
      <% } else { %>
        <a href="/register" class="btn-primary px-8 py-4 text-lg">Join the Network</a>
        <a href="/projects" class="inline-block px-8 py-4 rounded-full bg-white text-primary-600 font-semibold shadow-sm border border-primary-200 hover:bg-gray-50 transition duration-200 text-lg">Browse Projects</a>
      <% } %>
    </div>
  </div>
  
  <!-- Features Section -->
  <div class="mt-24 grid grid-cols-1 md:grid-cols-3 gap-8 w-full">
    <div class="card p-6 text-center hover:shadow-md transition-shadow">
      <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
      </div>
      <h3 class="text-lg font-bold text-gray-900 mb-2">Find Organizations</h3>
      <p class="text-gray-500">Discover amazing non-profits and organizations making a difference in your area.</p>
    </div>
    <div class="card p-6 text-center hover:shadow-md transition-shadow">
      <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
      </div>
      <h3 class="text-lg font-bold text-gray-900 mb-2">Browse Projects</h3>
      <p class="text-gray-500">Explore specific service projects and find the perfect match for your skills.</p>
    </div>
    <div class="card p-6 text-center hover:shadow-md transition-shadow">
      <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
      </div>
      <h3 class="text-lg font-bold text-gray-900 mb-2">Connect Volunteers</h3>
      <p class="text-gray-500">Join a growing community of volunteers dedicated to helping others.</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
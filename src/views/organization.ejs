<%- include('partials/header') %>
<div class="max-w-4xl mx-auto space-y-8">
  <div class="card p-8">
    <div class="flex justify-between items-start mb-6">
      <h1 class="text-3xl font-extrabold text-gray-900"><%= organizationDetails.name %></h1>
      <% if (isAdmin) { %>
        <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="inline-block px-4 py-2 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition text-sm">Edit Organization</a>
      <% } %>
    </div>

    <div class="flex flex-col md:flex-row gap-8 items-start mb-8">
      <div class="flex-shrink-0">
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo" class="w-32 h-32 object-contain bg-gray-50 rounded-2xl p-4 border border-gray-100">
      </div>
      <div>
        <p class="text-lg text-gray-700 leading-relaxed"><%= organizationDetails.description %></p>
      </div>
    </div>
  </div>

  <div class="card p-8 mt-8">
    <h3 class="text-xl font-bold text-gray-900 mb-4 border-b border-gray-100 pb-4">Service Projects</h3>
    <% if (projects.length > 0) { %>
      <ul class="space-y-3">
        <% projects.forEach(project => { %>
          <li>
            <a href="/project/<%= project.project_id %>" class="block p-4 rounded-lg bg-gray-50 hover:bg-primary-50 text-gray-800 hover:text-primary-700 transition-colors font-medium border border-transparent hover:border-primary-100">
              <%= project.title %> &rarr;
            </a>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="text-gray-500 italic">No service projects listed for this organization.</p>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

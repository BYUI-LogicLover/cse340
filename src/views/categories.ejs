<%- include('partials/header') %>
<div class="max-w-5xl mx-auto space-y-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-extrabold text-gray-900"><%= title %></h1>
    <% if (isAdmin) { %>
      <a href="/new-category" class="btn-primary">New Category</a>
    <% } %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% categories.forEach(category => { %>
      <div class="card p-6 hover:-translate-y-1 transition-transform duration-200 border-l-4 border-l-primary-500">
        <h2 class="text-xl font-bold text-gray-900 mb-2">
          <a href="/category/<%= category.category_id %>" class="hover:text-primary-600"><%= category.name %></a>
        </h2>
        <p class="text-gray-600 text-sm"><%= category.description %></p>
      </div>
    <% }); %>
  </div>
</div>
<%- include('partials/footer') %>

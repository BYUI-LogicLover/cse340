<%- include('partials/header') %>
<div class="max-w-2xl mx-auto space-y-8">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-6"><%= title %></h1>

  <form action="/new-category" method="POST" class="card p-8 space-y-6">
    <div>
      <label for="name" class="form-label">Category Name</label>
      <input type="text" id="name" name="name" required maxlength="150" class="input-field" />
    </div>

    <div>
      <label for="description" class="form-label">Description</label>
      <textarea id="description" name="description" required maxlength="500" class="input-field min-h-[120px]"></textarea>
    </div>

    <div class="pt-4 flex justify-end gap-3">
      <a href="/categories" class="btn-primary bg-gray-500 hover:bg-gray-600">Cancel</a>
      <button type="submit" class="btn-primary">Create Category</button>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
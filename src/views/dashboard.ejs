<%- include('partials/header') %>
<div class="max-w-3xl mx-auto space-y-8">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-6">Dashboard</h1>
  
  <div class="card p-8 text-center sm:text-left sm:flex sm:items-center sm:space-x-8">
    <div class="mx-auto sm:mx-0 w-24 h-24 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center text-4xl font-bold mb-4 sm:mb-0">
      <%= name.charAt(0).toUpperCase() %>
    </div>
    <div class="flex-1">
      <h2 class="text-2xl font-bold text-gray-900"><%= name %></h2>
      <p class="text-gray-500"><%= email %></p>
    </div>
    <% if (isAdmin) { %>
      <div class="mt-6 sm:mt-0">
        <a href="/users" class="btn-primary">Manage Users</a>
      </div>
    <% } %>
  </div>

  <div class="card p-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">My Volunteer Projects</h2>
    <% if (volunteerProjects.length > 0) { %>
      <div class="space-y-4">
        <% volunteerProjects.forEach(project => { %>
          <div class="flex items-center justify-between bg-gray-50 p-4 rounded-xl border border-gray-100">
            <div>
              <a href="/project/<%= project.project_id %>" class="text-lg font-semibold text-primary-600 hover:underline"><%= project.title %></a>
              <p class="text-sm text-gray-500"><%= project.start_date.toLocaleDateString() %> &mdash; <%= project.location %></p>
              <p class="text-sm text-gray-500"><%= project.organization_name %></p>
            </div>
            <form action="/dashboard/remove-volunteer/<%= project.project_id %>" method="POST">
              <button type="submit" class="inline-block px-4 py-2 bg-red-100 text-red-700 font-semibold rounded-lg hover:bg-red-200 transition text-sm">Remove</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-gray-500">You haven't volunteered for any projects yet. <a href="/projects" class="text-primary-600 hover:underline">Browse projects</a></p>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>

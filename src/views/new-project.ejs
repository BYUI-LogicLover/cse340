<%- include('partials/header') %>
<div class="max-w-2xl mx-auto space-y-8">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-6"><%= title %></h1>

  <form action="/new-project" method="POST" class="card p-8 space-y-6">
    <div>
      <label for="title" class="form-label">Project Title</label>
      <input type="text" id="title" name="title" required maxlength="200" class="input-field" />
    </div>

    <div>
      <label for="description" class="form-label">Description</label>
      <textarea id="description" name="description" required maxlength="1000" class="input-field min-h-[120px]"></textarea>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="location" class="form-label">Location</label>
        <input type="text" id="location" name="location" required maxlength="200" class="input-field" />
      </div>
      <div>
        <label for="date" class="form-label">Date</label>
        <input type="date" id="date" name="date" required class="input-field" />
      </div>
    </div>

    <div>
      <label for="organizationId" class="form-label">Organization</label>
      <select id="organizationId" name="organizationId" required class="input-field bg-white">
        <option value="">-- Select an Organization --</option>
        <% organizations.forEach(organization => { %>
          <option value="<%= organization.organization_id %>"><%= organization.name %></option>
        <% }); %>
      </select>
    </div>

    <div>
      <label for="categoryId" class="form-label">Category</label>
      <select id="categoryId" name="categoryId" class="input-field bg-white">
        <option value="">-- Select a Category --</option>
        <% categories.forEach(category => { %>
          <option value="<%= category.category_id %>"><%= category.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="pt-4 flex justify-end gap-3">
      <a href="/projects" class="btn-primary bg-gray-500 hover:bg-gray-600">Cancel</a>
      <button type="submit" class="btn-primary">Create Project</button>
    </div>
  </form>
</div>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <table>
    <tr>
      <th>Start Date</th>
      <th>Organization</th>
      <th>Description</th>
      <th>Categories</th>
      <% projects.forEach(project => { %>
    <tr>
      <td><strong><%= project.start_date.getMonth() + 1 %>/<%= project.start_date.getDate() %>/<%= project.start_date.getFullYear() %></strong></td>
      <td><%= project.organization_name %></td>
      <td><%= project.description %></td>
      <td><%= project.category_names %></td>
    </tr>
    <% }); %>
  </table>
</main>
<%- include('partials/footer') %>
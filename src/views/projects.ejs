<%- include('partials/header') %>
<div class="max-w-5xl mx-auto space-y-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-extrabold text-gray-900"><%= title %></h1>
    <% if (isAdmin) { %>
      <a href="/new-project" class="btn-primary">New Project</a>
    <% } %>
  </div>

  <ul class="space-y-4">
    <% projects.forEach(project => { %>
    <li class="card p-6 flex justify-between items-center hover:bg-gray-50 transition-colors">
      <div>
        <h2 class="text-xl font-bold text-gray-900">
          <a href="/project/<%= project.project_id %>" class="hover:text-primary-600"><%= project.title %></a>
        </h2>
        <p class="text-gray-500 text-sm mt-1">
          Organized by <a href="/organization/<%= project.organization_id %>" class="text-primary-600 hover:underline"><%= project.organization_name %></a>
        </p>
      </div>
      <a href="/project/<%= project.project_id %>" class="text-primary-600 hover:text-primary-800 font-semibold text-sm">View Details &rarr;</a>
    </li>
    <% }); %>
  </ul>
</div>
<%- include('partials/footer') %>

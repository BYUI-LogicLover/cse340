<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <p>Upcoming Service Projects:</p>
  <ul>

    <% projects.forEach(project => { %>
      <li><strong><%= project.start_date.getDate() %>/<%= project.start_date.getMonth() + 1 %>/<%= project.start_date.getFullYear() %>: <%= project.title %></strong> (<%= project.name %>)</li>
    <% }); %>
  </ul>
</main>
<%- include('partials/footer') %>
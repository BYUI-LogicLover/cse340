<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <p>Here are a few of our partner organizations:</p>
  <ul>

    <% organizations.forEach(organization => { %>
      <li class="org-item">
        <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
        <div class="org-info">
          <strong><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></strong>
          <span><a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></span>
        </div>
      </li>
    <% }); %>
  </ul>
  <% if (isAdmin) { %>
    <a href="/new-organization" class="btn-new">New</a>
  <% } %>
</main>

<%- include('partials/footer') %>